{
  "type": "page",
  "metadata": {
    "title": "Retries"
  },
  "onInit": {
    "type": "tool",
    "tool": "gate.report",
    "params": {}
  },
  "state": {
    "initial": {
      "attempts": 0,
      "accepted": 0,
      "peak": 0,
      "peakNote": "",
      "ok": true,
      "strategy": "",
      "rows": [],
      "compare": "",
      "notice": ""
    }
  },
  "content": {
    "type": "container",
    "decoration": {
      "color": "{{theme.color.surfaceContainerHighest}}"
    },
    "child": {
      "type": "linear",
      "direction": "vertical",
      "children": [
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 20,
            "bottom": 16
          },
          "decoration": {
            "color": "{{theme.color.surface}}",
            "border": {
              "bottom": true,
              "color": "{{theme.color.outline}}",
              "width": 1
            }
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "CHECKOUT → PAYMENTS · ONE OUTAGE",
                    "style": {
                      "fontSize": 12,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.8
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{strategy}}",
                    "style": {
                      "fontSize": 21,
                      "color": "{{theme.color.onSurface}}",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "gap": 4
              },
              {
                "type": "spacer"
              },
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "ATTEMPTS",
                    "style": {
                      "fontSize": 11,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.6
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{attempts}}",
                    "style": {
                      "fontSize": 26,
                      "color": "{{theme.color.onSurface}}",
                      "fontFamily": "JetBrainsMono"
                    }
                  }
                ],
                "gap": 4,
                "crossAxisAlignment": "end"
              }
            ]
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 10,
            "bottom": 4
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "button",
                "label": "Run: retry at once",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "gate.run",
                  "params": {
                    "strategy": "hammer"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "Run: back off with jitter",
                "variant": "filled",
                "onTap": {
                  "type": "tool",
                  "tool": "gate.run",
                  "params": {
                    "strategy": "backoff"
                  }
                }
              }
            ]
          }
        },
        {
          "type": "expanded",
          "child": {
            "type": "container",
            "padding": {
              "left": 22,
              "right": 22,
              "top": 16,
              "bottom": 8
            },
            "child": {
              "type": "container",
              "padding": {
                "all": 18
              },
              "decoration": {
                "color": "{{theme.color.surface}}",
                "borderRadius": 14,
                "border": {
                  "color": "{{theme.color.outline}}",
                  "width": 1
                }
              },
              "child": {
                "type": "list",
                "items": "{{rows}}",
                "shrinkWrap": true,
                "itemSpacing": 10,
                "emptyMessage": "No attempt landed",
                "itemTemplate": {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "container",
                      "width": 44,
                      "child": {
                        "type": "text",
                        "content": "{{item.n}}",
                        "textAlign": "start",
                        "maxLines": 1,
                        "style": {
                          "fontSize": 14,
                          "color": "{{theme.color.primary}}",
                          "textAlign": "start",
                          "fontFamily": "JetBrainsMono"
                        }
                      },
                      "alignment": "centerStart"
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "expanded",
                      "child": {
                        "type": "text",
                        "content": "{{item.line}}",
                        "style": {
                          "fontSize": 14,
                          "color": "{{theme.color.onSurface}}",
                          "fontFamily": "JetBrainsMono"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 0,
            "bottom": 8
          },
          "child": {
            "type": "container",
            "padding": {
              "all": 18
            },
            "decoration": {
              "color": "{{theme.color.surface}}",
              "borderRadius": 14,
              "border": {
                "color": "{{theme.color.outline}}",
                "width": 1
              }
            },
            "child": {
              "type": "linear",
              "direction": "vertical",
              "children": [
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "WORST WINDOW",
                      "style": {
                        "fontSize": 11,
                        "color": "{{theme.color.onSurfaceVariant}}",
                        "letterSpacing": 1.6
                      }
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "text",
                      "content": "{{peak}}",
                      "style": {
                        "fontSize": 18,
                        "color": "{{theme.color.warning}}",
                        "fontFamily": "JetBrainsMono"
                      }
                    }
                  ]
                },
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "expanded",
                      "child": {
                        "type": "text",
                        "content": "{{peakNote}}",
                        "style": {
                          "fontSize": 13,
                          "color": "{{theme.color.onSurfaceVariant}}"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "divider",
                  "color": "{{theme.color.outline}}"
                },
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "expanded",
                      "child": {
                        "type": "text",
                        "content": "{{compare}}",
                        "style": {
                          "fontSize": 13,
                          "color": "{{theme.color.onSurface}}"
                        }
                      }
                    }
                  ]
                }
              ],
              "gap": 10
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 4,
            "bottom": 18
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "expanded",
                "child": {
                  "type": "text",
                  "content": "{{notice}}",
                  "style": {
                    "fontSize": 13,
                    "color": "{{theme.color.primary}}"
                  }
                }
              },
              {
                "type": "text",
                "content": "{{accepted}} accepted",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.onSurfaceVariant}}",
                  "fontFamily": "JetBrainsMono"
                }
              }
            ]
          }
        }
      ],
      "crossAxisAlignment": "stretch"
    }
  }
}
